diff --git a/src/MarlinSimulator/websocket/websocket_serial.cpp b/src/MarlinSimulator/websocket/websocket_serial.cpp
new file mode 100644
index 0000000..1741c3f
--- /dev/null
+++ b/src/MarlinSimulator/websocket/websocket_serial.cpp
@@ -0,0 +1,259 @@
+#include "websocket_serial.h"
+#include "ws_protocol.h"
+
+// BSD sockets, as in agent_server.cpp and webcam.cpp (SDL_net can't bind
+// loopback-only). On Windows SDLNet_Init() has already called WSAStartup.
+#ifdef _WIN32
+  #include <winsock2.h>
+  #include <ws2tcpip.h>
+  using socket_t = SOCKET;
+  #define CLOSE_SOCKET closesocket
+  #define BAD_SOCKET INVALID_SOCKET
+  #define SEND_FLAGS 0
+#else
+  #include <sys/socket.h>
+  #include <netinet/in.h>
+  #include <netinet/tcp.h>
+  #include <unistd.h>
+  using socket_t = int;
+  #define CLOSE_SOCKET ::close
+  #define BAD_SOCKET (-1)
+  #ifdef MSG_NOSIGNAL
+    #define SEND_FLAGS MSG_NOSIGNAL
+  #else
+    #define SEND_FLAGS 0   // macOS: SO_NOSIGPIPE is set on each socket instead
+  #endif
+#endif
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+
+WebSocketSerial ws_serial;
+
+namespace {
+
+constexpr std::size_t max_handshake_size = 8192;
+constexpr int64_t handshake_timeout_ms = 5000;
+
+inline socket_t to_socket(intptr_t handle) { return socket_t(handle); }
+
+int64_t now_ms() {
+  using namespace std::chrono;
+  return duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+bool send_all(socket_t s, const uint8_t* data, std::size_t size) {
+  while (size) {
+    const auto n = ::send(s, (const char*)data, int(size), SEND_FLAGS);
+    if (n <= 0) return false;
+    data += n; size -= std::size_t(n);
+  }
+  return true;
+}
+bool send_all(socket_t s, const std::string& text) { return send_all(s, (const uint8_t*)text.data(), text.size()); }
+bool send_frame(socket_t s, ws::Opcode opcode, const uint8_t* data, std::size_t size) {
+  const auto frame = ws::encode_frame(opcode, data, size);
+  return send_all(s, frame.data(), frame.size());
+}
+bool send_close(socket_t s, uint16_t code) {
+  const uint8_t body[2] = { uint8_t(code >> 8), uint8_t(code) };
+  return send_frame(s, ws::Opcode::Close, body, 2);
+}
+
+void configure_client(socket_t s) {
+  #ifdef SO_NOSIGPIPE
+    int one = 1;
+    setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, (const char*)&one, sizeof(one));
+  #endif
+  int nodelay = 1;  // G-code replies are small; don't let Nagle add latency to "ok"
+  setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char*)&nodelay, sizeof(nodelay));
+}
+
+void reject(socket_t s, int code, const std::string& reason) {
+  send_all(s, ws::http_error_response(code, reason));
+  CLOSE_SOCKET(s);
+}
+
+} // namespace
+
+bool WebSocketSerial::start(uint16_t listen_port, std::vector<std::string> origins) {
+  if (running.load()) return true;
+
+  socket_t l = ::socket(AF_INET, SOCK_STREAM, 0);
+  if (l == BAD_SOCKET) { fprintf(stderr, "WebSocketSerial: socket() failed\n"); return false; }
+  int reuse = 1;
+  setsockopt(l, SOL_SOCKET, SO_REUSEADDR, (const char*)&reuse, sizeof(reuse));
+
+  sockaddr_in address {};
+  address.sin_family = AF_INET;
+  address.sin_port = htons(listen_port);
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);  // 127.0.0.1 only, by design
+  if (::bind(l, (sockaddr*)&address, sizeof(address)) != 0 || ::listen(l, 4) != 0) {
+    fprintf(stderr, "WebSocketSerial: can't listen on 127.0.0.1:%u (in use?)\n", unsigned(listen_port));
+    CLOSE_SOCKET(l);
+    return false;
+  }
+
+  listener = intptr_t(l);
+  port = listen_port;
+  allowed_origins = std::move(origins);
+  running = true;
+  thread = std::thread(&WebSocketSerial::run, this);
+  printf("WebSocketSerial: ws://127.0.0.1:%u/ (serial stream 3)\n", unsigned(port));
+  fflush(stdout);
+  return true;
+}
+
+void WebSocketSerial::stop() {
+  if (!running.exchange(false)) return;
+  if (thread.joinable()) thread.join();
+  CLOSE_SOCKET(to_socket(listener));
+  listener = -1;
+}
+
+void WebSocketSerial::write(const uint8_t* data, std::size_t length) {
+  if (!client_open.load()) return;  // nobody listening: drop, like a serial line with nothing attached
+  tx_buffer.write(data, length);
+}
+
+void WebSocketSerial::run() {
+  const socket_t l = to_socket(listener);
+
+  enum class State { None, Handshaking, Open } state = State::None;
+  socket_t client = BAD_SOCKET;
+  std::string handshake;
+  int64_t handshake_deadline = 0;
+  ws::FrameDecoder decoder;
+  static uint8_t chunk[16384];
+  static uint8_t outgoing[WebSocketSerial::buffer_size];
+  bool warned_rx_overflow = false;
+
+  auto disconnect = [&](const char* why) {
+    if (client != BAD_SOCKET) CLOSE_SOCKET(client);
+    if (state == State::Open) printf("WebSocketSerial: client disconnected (%s)\n", why);
+    client = BAD_SOCKET;
+    state = State::None;
+    client_open = false;
+    handshake.clear();
+    fflush(stdout);
+  };
+
+  while (running.load()) {
+    fd_set set; FD_ZERO(&set);
+    FD_SET(l, &set);
+    socket_t highest = l;
+    if (client != BAD_SOCKET) { FD_SET(client, &set); if (client > highest) highest = client; }
+
+    // A short timeout keeps Marlin's output flowing to the client promptly.
+    timeval tv { 0, 1000 };
+    const int ready = ::select(int(highest) + 1, &set, nullptr, nullptr, &tv);
+
+    if (ready > 0 && FD_ISSET(l, &set)) {
+      socket_t s = ::accept(l, nullptr, nullptr);
+      if (s != BAD_SOCKET) {
+        configure_client(s);
+        if (state != State::None) reject(s, 409, "Another client is already connected to the simulator");
+        else {
+          client = s;
+          state = State::Handshaking;
+          handshake.clear();
+          handshake_deadline = now_ms() + handshake_timeout_ms;
+        }
+      }
+    }
+
+    if (state == State::Handshaking && now_ms() > handshake_deadline) disconnect("handshake timeout");
+
+    if (ready > 0 && client != BAD_SOCKET && FD_ISSET(client, &set)) {
+      const auto n = ::recv(client, (char*)chunk, int(sizeof(chunk)), 0);
+      if (n <= 0) { disconnect("connection closed"); continue; }
+
+      if (state == State::Handshaking) {
+        handshake.append((const char*)chunk, std::size_t(n));
+        const auto end = handshake.find("\r\n\r\n");
+        if (end == std::string::npos) {
+          if (handshake.size() > max_handshake_size) {
+            reject(client, 431, "Request head too large");
+            client = BAD_SOCKET; state = State::None;
+          }
+          continue;
+        }
+
+        const auto request = ws::parse_handshake(handshake.substr(0, end + 4));
+        if (!request.valid) {
+          reject(client, 400, request.error);
+          client = BAD_SOCKET; state = State::None;
+          continue;
+        }
+        if (!ws::origin_allowed(request.origin, allowed_origins)) {
+          fprintf(stderr, "WebSocketSerial: refused origin '%s' (allow it with --ws-allow-origin)\n", request.origin.c_str());
+          reject(client, 403, "Origin not allowed: " + request.origin);
+          client = BAD_SOCKET; state = State::None;
+          continue;
+        }
+        if (!send_all(client, ws::handshake_response(request.key))) { disconnect("handshake send failed"); continue; }
+
+        decoder = ws::FrameDecoder();
+        tx_buffer.clear();      // start the client on a clean stream
+        warned_rx_overflow = false;
+        state = State::Open;
+        client_open = true;
+        printf("WebSocketSerial: client connected%s%s\n", request.origin.empty() ? "" : " from ", request.origin.c_str());
+        fflush(stdout);
+
+        // Any bytes after the handshake head are the first frames.
+        if (handshake.size() > end + 4)
+          decoder.feed((const uint8_t*)handshake.data() + end + 4, handshake.size() - end - 4);
+        handshake.clear();
+      }
+      else {
+        decoder.feed(chunk, std::size_t(n));
+      }
+
+      ws::FrameDecoder::Event event;
+      bool closed = false;
+      while (!closed && decoder.next(event)) {
+        switch (event.kind) {
+          case ws::FrameDecoder::Event::Kind::Data: {
+            const auto written = rx_buffer.write(event.payload.data(), event.payload.size());
+            if (written < event.payload.size() && !warned_rx_overflow) {
+              fprintf(stderr, "WebSocketSerial: input buffer full, %zu bytes dropped (is the client waiting for \"ok\"?)\n",
+                      event.payload.size() - written);
+              warned_rx_overflow = true;
+            }
+            break;
+          }
+          case ws::FrameDecoder::Event::Kind::Ping:
+            send_frame(client, ws::Opcode::Pong, event.payload.data(), event.payload.size());
+            break;
+          case ws::FrameDecoder::Event::Kind::Pong:
+            break;
+          case ws::FrameDecoder::Event::Kind::Close:
+            send_close(client, event.payload.size() >= 2 ? event.close_code : 1000);
+            disconnect("closed by client");
+            closed = true;
+            break;
+          case ws::FrameDecoder::Event::Kind::Error:
+            fprintf(stderr, "WebSocketSerial: protocol error: %s\n", event.error.c_str());
+            send_close(client, event.close_code);
+            disconnect("protocol error");
+            closed = true;
+            break;
+        }
+      }
+      if (closed) continue;
+    }
+
+    if (state == State::Open && tx_buffer.available()) {
+      const auto count = tx_buffer.read(outgoing, sizeof(outgoing));
+      if (!send_frame(client, ws::Opcode::Binary, outgoing, count)) disconnect("send failed");
+    }
+  }
+
+  if (client != BAD_SOCKET) {
+    if (state == State::Open) send_close(client, 1001);  // going away
+    CLOSE_SOCKET(client);
+  }
+  client_open = false;
+}
diff --git a/src/MarlinSimulator/websocket/websocket_serial.h b/src/MarlinSimulator/websocket/websocket_serial.h
new file mode 100644
index 0000000..a934e3c
--- /dev/null
+++ b/src/MarlinSimulator/websocket/websocket_serial.h
@@ -0,0 +1,69 @@
+#pragma once
+
+/**
+ * WebSocket bridge to Marlin's serial stream 3, for web apps.
+ *
+ * Browsers can't open the raw TCP G-code socket (--serial-port), so this
+ * serves the same byte stream over a WebSocket. A page connects to
+ * ws://127.0.0.1:<port>/ and gets the bytes Marlin writes to stream 3 as
+ * binary messages; any text or binary message it sends is fed to Marlin as
+ * serial input. Message boundaries carry no meaning, exactly like a serial
+ * port: a web app can use the same line handling for this and Web Serial.
+ *
+ * - Off unless --ws-port <n> (or MARLIN_SIM_WS_PORT) is given.
+ * - Listens on 127.0.0.1 only, since it executes G-code.
+ * - Checks the Origin header so an arbitrary web page can't drive the
+ *   simulator. Pages on localhost / 127.0.0.1 / [::1] are allowed; add others
+ *   with --ws-allow-origin <origin> (repeatable, "*" allows all).
+ * - One client at a time. A second connection is refused (409) rather than
+ *   silently taking over the first one's session.
+ * - Output Marlin produced while no client was connected is discarded on
+ *   connect, so a client starts from a clean stream.
+ *
+ * Like the raw socket, stream 3 is only read by Marlin when a serial port maps
+ * to it (#define SERIAL_PORT_2 3 in Configuration.h).
+ */
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <cstring>   // RingBuffer.h uses memcpy and numeric_limits without including them
+#include <limits>
+#include <RingBuffer.h>
+
+class WebSocketSerial {
+public:
+  static constexpr std::size_t buffer_size = 32768;
+
+  // Starts listening. Non-fatal: returns false (and logs) if the port is busy.
+  bool start(uint16_t port, std::vector<std::string> allowed_origins);
+  void stop();
+  bool connected() const { return client_open.load(); }
+
+  // Simulation thread side.
+  void write(const uint8_t* data, std::size_t length);   // Marlin -> client (dropped when no client)
+  std::size_t available() { return rx_buffer.available(); }
+  std::size_t read(uint8_t* dst, std::size_t length) { return rx_buffer.read(dst, length); }
+
+  ~WebSocketSerial() { stop(); }
+
+private:
+  void run();
+
+  std::atomic_bool running{false};
+  std::atomic_bool client_open{false};
+  std::thread thread;
+  intptr_t listener = -1;  // socket handle, platform type hidden in the .cpp
+  uint16_t port = 0;
+  std::vector<std::string> allowed_origins;
+
+  RingBuffer<uint8_t, buffer_size> rx_buffer;   // client -> Marlin
+  RingBuffer<uint8_t, buffer_size> tx_buffer;   // Marlin -> client
+};
+
+extern WebSocketSerial ws_serial;
diff --git a/src/MarlinSimulator/websocket/ws_protocol.cpp b/src/MarlinSimulator/websocket/ws_protocol.cpp
new file mode 100644
index 0000000..314d371
--- /dev/null
+++ b/src/MarlinSimulator/websocket/ws_protocol.cpp
@@ -0,0 +1,311 @@
+#include "ws_protocol.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+
+namespace ws {
+
+namespace {
+
+inline uint32_t rotl(uint32_t value, int bits) { return (value << bits) | (value >> (32 - bits)); }
+
+std::string to_lower(std::string text) {
+  std::transform(text.begin(), text.end(), text.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  return text;
+}
+
+std::string trim(const std::string& text) {
+  const auto first = text.find_first_not_of(" \t");
+  if (first == std::string::npos) return "";
+  const auto last = text.find_last_not_of(" \t\r");
+  return text.substr(first, last - first + 1);
+}
+
+// True if a comma-separated header value contains token (case-insensitive).
+bool has_token(const std::string& value, const std::string& token) {
+  std::size_t start = 0;
+  while (start <= value.size()) {
+    std::size_t end = value.find(',', start);
+    if (end == std::string::npos) end = value.size();
+    if (to_lower(trim(value.substr(start, end - start))) == token) return true;
+    start = end + 1;
+  }
+  return false;
+}
+
+const char* status_text(int code) {
+  switch (code) {
+    case 400: return "Bad Request";
+    case 403: return "Forbidden";
+    case 404: return "Not Found";
+    case 409: return "Conflict";
+    case 426: return "Upgrade Required";
+    case 431: return "Request Header Fields Too Large";
+    default:  return "Error";
+  }
+}
+
+} // namespace
+
+std::array<uint8_t, 20> sha1(const uint8_t* data, std::size_t length) {
+  uint32_t h[5] = { 0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0 };
+
+  // Pad: 0x80, zeros, then the bit length as a 64-bit big-endian number.
+  std::vector<uint8_t> message(data, data + length);
+  message.push_back(0x80);
+  while (message.size() % 64 != 56) message.push_back(0);
+  const uint64_t bit_length = uint64_t(length) * 8;
+  for (int i = 7; i >= 0; --i) message.push_back(uint8_t(bit_length >> (i * 8)));
+
+  for (std::size_t chunk = 0; chunk < message.size(); chunk += 64) {
+    uint32_t w[80];
+    for (int i = 0; i < 16; ++i) {
+      const uint8_t* p = &message[chunk + i * 4];
+      w[i] = (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+    }
+    for (int i = 16; i < 80; ++i) w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+
+    uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+    for (int i = 0; i < 80; ++i) {
+      uint32_t f, k;
+      if (i < 20)      { f = (b & c) | (~b & d);           k = 0x5A827999; }
+      else if (i < 40) { f = b ^ c ^ d;                    k = 0x6ED9EBA1; }
+      else if (i < 60) { f = (b & c) | (b & d) | (c & d);  k = 0x8F1BBCDC; }
+      else             { f = b ^ c ^ d;                    k = 0xCA62C1D6; }
+      const uint32_t temp = rotl(a, 5) + f + e + k + w[i];
+      e = d; d = c; c = rotl(b, 30); b = a; a = temp;
+    }
+    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
+  }
+
+  std::array<uint8_t, 20> digest{};
+  for (int i = 0; i < 5; ++i)
+    for (int j = 0; j < 4; ++j) digest[i * 4 + j] = uint8_t(h[i] >> (24 - j * 8));
+  return digest;
+}
+
+std::string base64_encode(const uint8_t* data, std::size_t length) {
+  static constexpr char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  std::string out;
+  out.reserve((length + 2) / 3 * 4);
+  for (std::size_t i = 0; i < length; i += 3) {
+    const uint32_t n = (uint32_t(data[i]) << 16)
+                     | (i + 1 < length ? uint32_t(data[i + 1]) << 8 : 0)
+                     | (i + 2 < length ? uint32_t(data[i + 2]) : 0);
+    out += alphabet[(n >> 18) & 63];
+    out += alphabet[(n >> 12) & 63];
+    out += i + 1 < length ? alphabet[(n >> 6) & 63] : '=';
+    out += i + 2 < length ? alphabet[n & 63] : '=';
+  }
+  return out;
+}
+
+std::string accept_key(const std::string& client_key) {
+  const std::string text = client_key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+  const auto digest = sha1((const uint8_t*)text.data(), text.size());
+  return base64_encode(digest.data(), digest.size());
+}
+
+HandshakeRequest parse_handshake(const std::string& head) {
+  HandshakeRequest request;
+
+  std::size_t line_end = head.find("\r\n");
+  if (line_end == std::string::npos) { request.error = "no request line"; return request; }
+
+  // Request line: GET <path> HTTP/1.1
+  const std::string request_line = head.substr(0, line_end);
+  const auto space1 = request_line.find(' ');
+  const auto space2 = request_line.find(' ', space1 == std::string::npos ? 0 : space1 + 1);
+  if (space1 == std::string::npos || space2 == std::string::npos) { request.error = "malformed request line"; return request; }
+  if (request_line.substr(0, space1) != "GET") { request.error = "method must be GET"; return request; }
+  request.path = request_line.substr(space1 + 1, space2 - space1 - 1);
+  if (request_line.compare(space2 + 1, std::string::npos, "HTTP/1.1") != 0) { request.error = "HTTP/1.1 required"; return request; }
+
+  std::string upgrade, connection, version;
+  std::size_t pos = line_end + 2;
+  while (pos < head.size()) {
+    line_end = head.find("\r\n", pos);
+    if (line_end == std::string::npos || line_end == pos) break;  // blank line ends the head
+    const std::string line = head.substr(pos, line_end - pos);
+    pos = line_end + 2;
+    const auto colon = line.find(':');
+    if (colon == std::string::npos) continue;
+    const std::string name = to_lower(trim(line.substr(0, colon)));
+    const std::string value = trim(line.substr(colon + 1));
+    if (name == "upgrade") upgrade = value;
+    else if (name == "connection") connection = value;
+    else if (name == "sec-websocket-version") version = value;
+    else if (name == "sec-websocket-key") request.key = value;
+    else if (name == "origin") request.origin = value;
+  }
+
+  if (!has_token(upgrade, "websocket"))   { request.error = "not a WebSocket upgrade (Upgrade header)"; return request; }
+  if (!has_token(connection, "upgrade"))  { request.error = "not a WebSocket upgrade (Connection header)"; return request; }
+  if (version != "13")                    { request.error = "Sec-WebSocket-Version 13 required"; return request; }
+  if (request.key.size() != 24)           { request.error = "invalid Sec-WebSocket-Key"; return request; }
+
+  request.valid = true;
+  return request;
+}
+
+bool origin_allowed(const std::string& origin, const std::vector<std::string>& allowed) {
+  if (origin.empty()) return true;  // not a browser page
+
+  const std::string normalized = to_lower(origin);
+  for (const auto& entry : allowed) {
+    if (entry == "*") return true;
+    std::string candidate = to_lower(entry);
+    while (!candidate.empty() && candidate.back() == '/') candidate.pop_back();
+    if (candidate == normalized) return true;
+  }
+
+  // Loopback pages: scheme://host[:port] with host localhost, 127.0.0.1 or [::1].
+  std::string rest;
+  if (normalized.rfind("http://", 0) == 0) rest = normalized.substr(7);
+  else if (normalized.rfind("https://", 0) == 0) rest = normalized.substr(8);
+  else return false;  // includes "null" (file:// pages, sandboxed frames)
+
+  std::string host = rest;
+  if (host.rfind("[::1]", 0) == 0) host = host.substr(5);
+  else if (host.rfind("localhost", 0) == 0) host = host.substr(9);
+  else if (host.rfind("127.0.0.1", 0) == 0) host = host.substr(9);
+  else return false;
+
+  if (host.empty()) return true;
+  if (host[0] != ':' || host.size() == 1) return false;
+  return std::all_of(host.begin() + 1, host.end(), [](unsigned char c) { return std::isdigit(c); });
+}
+
+std::string handshake_response(const std::string& client_key) {
+  return "HTTP/1.1 101 Switching Protocols\r\n"
+         "Upgrade: websocket\r\n"
+         "Connection: Upgrade\r\n"
+         "Sec-WebSocket-Accept: " + accept_key(client_key) + "\r\n"
+         "\r\n";
+}
+
+std::string http_error_response(int code, const std::string& reason) {
+  const std::string body = reason + "\n";
+  return "HTTP/1.1 " + std::to_string(code) + " " + status_text(code) + "\r\n"
+         "Content-Type: text/plain\r\n"
+         "Content-Length: " + std::to_string(body.size()) + "\r\n"
+         "Sec-WebSocket-Version: 13\r\n"
+         "Connection: close\r\n"
+         "\r\n" + body;
+}
+
+std::vector<uint8_t> encode_frame(Opcode opcode, const uint8_t* payload, std::size_t length) {
+  std::vector<uint8_t> frame;
+  frame.reserve(length + 10);
+  frame.push_back(uint8_t(0x80 | uint8_t(opcode)));  // FIN, no RSV bits
+  if (length < 126) {
+    frame.push_back(uint8_t(length));
+  }
+  else if (length <= 0xFFFF) {
+    frame.push_back(126);
+    frame.push_back(uint8_t(length >> 8));
+    frame.push_back(uint8_t(length));
+  }
+  else {
+    frame.push_back(127);
+    for (int i = 7; i >= 0; --i) frame.push_back(uint8_t(uint64_t(length) >> (i * 8)));
+  }
+  frame.insert(frame.end(), payload, payload + length);
+  return frame;
+}
+
+void FrameDecoder::feed(const uint8_t* data, std::size_t length) {
+  if (error_state) return;
+  // Drop consumed bytes once they dominate the buffer.
+  if (consumed > 0 && consumed >= buffer.size() / 2) {
+    buffer.erase(buffer.begin(), buffer.begin() + consumed);
+    consumed = 0;
+  }
+  buffer.insert(buffer.end(), data, data + length);
+}
+
+bool FrameDecoder::next(Event& event) {
+  if (error_state) return false;
+
+  auto emit = [&](Event::Kind kind, std::vector<uint8_t> payload, uint16_t code = 1000, const char* why = "") {
+    event.kind = kind;
+    event.payload = std::move(payload);
+    event.close_code = code;
+    event.error = why;
+    return true;
+  };
+  auto fail = [&](uint16_t code, const char* why) {
+    error_state = true;
+    return emit(Event::Kind::Error, {}, code, why);
+  };
+
+  const std::size_t available = buffer.size() - consumed;
+  if (available < 2) return false;
+  const uint8_t* p = buffer.data() + consumed;
+
+  const bool fin = p[0] & 0x80;
+  const uint8_t rsv = p[0] & 0x70;
+  const uint8_t opcode = p[0] & 0x0F;
+  const bool masked = p[1] & 0x80;
+  uint64_t payload_length = p[1] & 0x7F;
+
+  if (rsv) return fail(1002, "reserved bits set (no extensions negotiated)");
+  if (!masked) return fail(1002, "client frames must be masked");
+
+  std::size_t header = 2;
+  if (payload_length == 126) {
+    if (available < 4) return false;
+    payload_length = (uint64_t(p[2]) << 8) | p[3];
+    header = 4;
+  }
+  else if (payload_length == 127) {
+    if (available < 10) return false;
+    payload_length = 0;
+    for (int i = 0; i < 8; ++i) payload_length = (payload_length << 8) | p[2 + i];
+    header = 10;
+  }
+
+  const bool control = opcode & 0x08;
+  if (control && (!fin || payload_length > 125)) return fail(1002, "invalid control frame");
+  if (payload_length > max_frame_payload) return fail(1009, "frame too large");
+
+  if (available < header + 4 + payload_length) return false;  // wait for the rest
+
+  const uint8_t* mask = p + header;
+  const uint8_t* body = mask + 4;
+  std::vector<uint8_t> payload(static_cast<std::size_t>(payload_length));
+  for (std::size_t i = 0; i < payload.size(); ++i) payload[i] = body[i] ^ mask[i & 3];
+  consumed += header + 4 + std::size_t(payload_length);
+
+  switch (Opcode(opcode)) {
+    case Opcode::Continuation:
+      if (!in_fragmented_message) return fail(1002, "continuation without a message");
+      if (fin) in_fragmented_message = false;
+      return emit(Event::Kind::Data, std::move(payload));
+
+    case Opcode::Text:     // Text is not checked for valid UTF-8: the bridge carries
+    case Opcode::Binary:   // serial bytes and Marlin does its own parsing.
+      if (in_fragmented_message) return fail(1002, "new message inside a fragmented one");
+      in_fragmented_message = !fin;
+      return emit(Event::Kind::Data, std::move(payload));
+
+    case Opcode::Ping:
+      return emit(Event::Kind::Ping, std::move(payload));
+
+    case Opcode::Pong:
+      return emit(Event::Kind::Pong, std::move(payload));
+
+    case Opcode::Close: {
+      if (payload.size() == 1) return fail(1002, "invalid close frame");
+      uint16_t code = 1000;
+      if (payload.size() >= 2) code = uint16_t((payload[0] << 8) | payload[1]);
+      return emit(Event::Kind::Close, std::move(payload), code);
+    }
+
+    default:
+      return fail(1002, "unknown opcode");
+  }
+}
+
+} // namespace ws
diff --git a/src/MarlinSimulator/websocket/ws_protocol.h b/src/MarlinSimulator/websocket/ws_protocol.h
new file mode 100644
index 0000000..3996436
--- /dev/null
+++ b/src/MarlinSimulator/websocket/ws_protocol.h
@@ -0,0 +1,82 @@
+#pragma once
+
+/**
+ * WebSocket protocol pieces (RFC 6455) with no socket code, so they can be
+ * unit-tested on their own: the opening handshake, the Origin check, and frame
+ * encoding/decoding. websocket_serial.cpp does the networking.
+ */
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ws {
+
+// SHA-1 of data (used only for the handshake accept key, not for security).
+std::array<uint8_t, 20> sha1(const uint8_t* data, std::size_t length);
+std::string base64_encode(const uint8_t* data, std::size_t length);
+
+// Sec-WebSocket-Accept value for a client's Sec-WebSocket-Key.
+std::string accept_key(const std::string& client_key);
+
+// Parsed opening handshake.
+struct HandshakeRequest {
+  bool valid = false;        // well-formed WebSocket upgrade request
+  std::string error;         // why not, when !valid
+  std::string path;
+  std::string key;           // Sec-WebSocket-Key
+  std::string origin;        // empty if the client sent none (non-browser clients)
+};
+
+// Parses an HTTP request head (everything up to and including "\r\n\r\n").
+HandshakeRequest parse_handshake(const std::string& head);
+
+// Origin policy. Browsers always send Origin, so this decides which web pages
+// may drive the simulator: pages served
+// from localhost / 127.0.0.1 / [::1] (http or https, any port) are always
+// allowed; configured origins are added to those. An
+// entry of "*" allows every origin. A request without Origin (curl, scripts)
+// is always allowed: it cannot come from a web page.
+bool origin_allowed(const std::string& origin, const std::vector<std::string>& allowed);
+
+std::string handshake_response(const std::string& client_key);
+std::string http_error_response(int code, const std::string& reason);
+
+enum class Opcode : uint8_t {
+  Continuation = 0x0, Text = 0x1, Binary = 0x2,
+  Close = 0x8, Ping = 0x9, Pong = 0xA,
+};
+
+// Encodes one unmasked, unfragmented server frame.
+std::vector<uint8_t> encode_frame(Opcode opcode, const uint8_t* payload, std::size_t length);
+
+// Incremental decoder for client frames. Feed bytes as they arrive; complete
+// events come out of next(). Data messages (text, binary, and their
+// continuation fragments) are delivered fragment by fragment, since for a
+// serial bridge only the byte stream matters, not message boundaries.
+class FrameDecoder {
+public:
+  static constexpr std::size_t max_frame_payload = 1 << 20;  // 1 MiB per frame
+
+  struct Event {
+    enum class Kind { Data, Ping, Pong, Close, Error } kind;
+    std::vector<uint8_t> payload;   // Data bytes, Ping/Pong payload, Close body
+    uint16_t close_code = 1000;     // Close and Error: code to send back
+    std::string error;              // Error: description
+  };
+
+  void feed(const uint8_t* data, std::size_t length);
+  // Returns false when no complete event is buffered.
+  bool next(Event& event);
+  bool failed() const { return error_state; }
+
+private:
+  std::vector<uint8_t> buffer;
+  std::size_t consumed = 0;
+  bool error_state = false;
+  bool in_fragmented_message = false;
+};
+
+} // namespace ws
